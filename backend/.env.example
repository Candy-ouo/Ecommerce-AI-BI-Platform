# ===== 数据库引擎 =====
# hive（默认，接 A 在 Hive 建的 DWS/ADS 聚合表）| duckdb（本地兜底，无 Hive 时开发调试）
DB_ENGINE=hive

# ===== Hive / Spark =====
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_USER=hive
HIVE_PASSWORD=
HIVE_DATABASE=ecommerce_bi

# ===== DuckDB 本地兜底（DB_ENGINE=duckdb 时启用）=====
DUCKDB_PATH=data/processed/ecommerce.duckdb

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce_bi

# ===== LLM API =====
# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问（备用）
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认使用的LLM: deepseek 或 qwen
LLM_PROVIDER=deepseek

# ===== Flask =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# ===== 数据开关 =====
# false：接口返回 Mock（Demo 可跑，不依赖 A 的表）
# true ：A 把聚合表在 Hive 建好 + SCHEMA_CHECKLIST 确认后，切真 SQL
USE_REAL_DATA=false
